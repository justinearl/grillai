{
  "name": "grillai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local GitLab-style review of AI-made changes, with Claude answering questions on any line",
  "bin": { "grillai": "bin/grillai.mjs" },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts --no-open\" \"vite\"",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.mjs --log-level=warning",
    "start": "node bin/grillai.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "diff2html": "^3.4.48",
    "express": "^5.1.0",
    "highlight.js": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
